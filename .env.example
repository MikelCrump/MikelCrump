# App
# Canonical public origin of this deployment (no trailing slash). Used for auth redirects / embed URLs.
NEXT_PUBLIC_APP_URL=

# Optional path prefix when mounting under another host (e.g. Command Center). Example: /apps/tableflow
NEXT_PUBLIC_BASE_PATH=

# Supabase
# Project URL from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — safe for browser; RLS still applies
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only; bypasses RLS for form submit, workspace provision, Airtable sync
SUPABASE_SERVICE_ROLE_KEY=

# Airtable (optional)
# Personal access token used for direct Airtable → Tables import. Without it, sync uses Command Center edge functions + user JWT.
AIRTABLE_TOKEN=
# Optional overrides if the shared token cannot read those bases
AIRTABLE_PASTORS_TOKEN=
AIRTABLE_VOLUNTEERS_TOKEN=
