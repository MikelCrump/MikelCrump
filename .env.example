# Database (Vercel Postgres / Neon in prod; local Postgres for dev)
DATABASE_URL="postgresql://crump:crump@localhost:5432/crump_studio?schema=public"

# ── Locked decisions (Phase 2) ──────────────────────────────────────────────
# Auth: Clerk (email allowlist configured in Clerk dashboard)
AUTH_PROVIDER="clerk"
# Storage: Vercel Blob
STORAGE_PROVIDER="blob"
# Video engines available: mock | runway | kling | veo | pika
VIDEO_PROVIDER="mock"
# Audio: mock | elevenlabs
AUDIO_PROVIDER="mock"

# ── Clerk (plug in when auth UI is wired) ───────────────────────────────────
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# ── Vercel Blob ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Video provider keys (stubs until plugged in; keep VIDEO_PROVIDER=mock) ──
RUNWAY_API_KEY=""
KLING_API_KEY=""
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""
GOOGLE_VEO_API_KEY=""
PIKA_API_KEY=""

# ── Audio ───────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=""

# App
NODE_ENV="development"

# ── Life Ops (/life) — all optional; board uses preview data until set ──────
LIFE_FORCE_MOCK="1"
GOVEE_API_KEY=""
TESLA_ACCESS_TOKEN=""
TESLA_VEHICLE_ID=""
TESLA_COMMAND_PROXY_URL=""
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_ACCESS_TOKEN=""
RENPHO_EMAIL=""
RENPHO_PASSWORD=""
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""
RIDEO_ENTITY_ID=""
APPLE_TV_ENTITY_ID=""
ROKU_HOST=""
RUSTDESK_API_URL=""
RUSTDESK_API_TOKEN=""
OPENWEATHER_API_KEY=""
WEATHER_LAT=""
WEATHER_LON=""
WEATHER_LOCATION_LABEL="Home area"
COMMUTE_ORIGIN=""
COMMUTE_DESTINATION="Work"
GOOGLE_MAPS_API_KEY=""
# JSON matching AiCreditsSnapshot when you want live AI meters
LIFE_AI_CREDITS_JSON=""
