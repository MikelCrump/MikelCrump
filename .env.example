# Brevo (required for live email)
BREVO_API_KEY=xkeysib-your-api-key

# Optional sender overrides (must be a verified sender in Brevo)
BREVO_SENDER_EMAIL=hello@yourcompany.com
BREVO_SENDER_NAME=ReachFlow

# Twilio (required for live SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Optional: Messaging Service (needed for scheduled SMS)
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: API Key auth instead of Auth Token (recommended for production)
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=your-api-secret

# Reawaken Command Center (Supabase CRM)
# Project: https://izterlcgwtguotdxyaza.supabase.co
SUPABASE_URL=https://izterlcgwtguotdxyaza.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required to read CRM rows (RLS blocks the anon key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL (used in email logo links)
NEXT_PUBLIC_APP_URL=https://reachflow-zeta.vercel.app

# When mounted under Command Center Tools (same as TableFlow /apps/tableflow):
# NEXT_PUBLIC_BASE_PATH=/apps/communications
# NEXT_PUBLIC_APP_URL=https://reawakencommandcenter.com
