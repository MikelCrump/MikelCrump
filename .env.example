# Database (Vercel Postgres / Neon in prod; local Postgres for dev)
DATABASE_URL="postgresql://crump:crump@localhost:5432/crump_studio?schema=public"

# ── Locked decisions (Phase 2) ──────────────────────────────────────────────
# Auth: Clerk (email allowlist configured in Clerk dashboard)
AUTH_PROVIDER="clerk"
# Storage: Vercel Blob
STORAGE_PROVIDER="blob"
# Video engines available: mock | runway | kling | veo | pika
VIDEO_PROVIDER="mock"
# Audio: mock | elevenlabs
AUDIO_PROVIDER="mock"

# ── Clerk (plug in when auth UI is wired) ───────────────────────────────────
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# ── Vercel Blob ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Video provider keys (stubs until plugged in; keep VIDEO_PROVIDER=mock) ──
RUNWAY_API_KEY=""
KLING_API_KEY=""
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""
GOOGLE_VEO_API_KEY=""
PIKA_API_KEY=""

# ── Audio ───────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=""

# App
NODE_ENV="development"

# ── Life Ops (/life) ────────────────────────────────────────────────────────
# Set to 1 only when you want to force preview data even with keys present.
LIFE_FORCE_MOCK="0"

# Govee (cloud)
GOVEE_API_KEY=""

# Tesla Fleet — OAuth via /life/tesla "Connect Tesla", or paste tokens
TESLA_CLIENT_ID=""
TESLA_CLIENT_SECRET=""
TESLA_REDIRECT_URI=""
TESLA_ACCESS_TOKEN=""
TESLA_REFRESH_TOKEN=""
TESLA_VEHICLE_ID=""
TESLA_VIN=""
TESLA_FLEET_BASE="https://fleet-api.prd.na.vn.cloud.tesla.com"
TESLA_COMMAND_PROXY_URL=""

# Plaid — after Link, set PLAID_ACCESS_TOKEN from /api/life/plaid/exchange
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_ACCESS_TOKEN=""

# Renpho Health app email/password (unofficial cloud API)
RENPHO_EMAIL=""
RENPHO_PASSWORD=""

# Home Assistant bridge (Resideo, Apple TV, batteries)
HOME_ASSISTANT_URL=""
HOME_ASSISTANT_TOKEN=""
RESIDEO_ENTITY_ID=""
APPLE_TV_ENTITY_ID=""
HA_AUTOMATION_WEBHOOK_ID=""

# Roku LAN ECP
ROKU_HOST=""

# RustDesk self-hosted API
RUSTDESK_API_URL=""
RUSTDESK_API_TOKEN=""

# Weather
OPENWEATHER_API_KEY=""
WEATHER_LAT=""
WEATHER_LON=""
WEATHER_LOCATION_LABEL="Home area"

# Home geofence (iPhone arrive → Tesla charge port automation)
# Defaults to WEATHER_LAT / WEATHER_LON when unset
HOME_LAT=""
HOME_LON=""
HOME_RADIUS_M="120"
# Optional shared secret for POST /api/life/location (Bearer or ?secret=)
LIFE_LOCATION_WEBHOOK_SECRET=""

# Commute
COMMUTE_ORIGIN=""
COMMUTE_DESTINATION="Work"
GOOGLE_MAPS_API_KEY=""

# Google Calendar
GOOGLE_CALENDAR_ACCESS_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# AI credits — admin/API where available; JSON for consumer chat quotas
CLAUDE_ADMIN_API_KEY_1=""
CLAUDE_ADMIN_API_KEY_2=""
CURSOR_ADMIN_API_KEY=""
XAI_API_KEY=""
LIFE_AI_CREDITS_JSON=""

# Tesla Fleet partner registration (public key at /.well-known/appspecific/com.tesla.3p.public-key.pem)
TESLA_PARTNER_DOMAIN="mikelcrump.com"
TESLA_PRIVATE_KEY_PEM=""
