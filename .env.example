# Database (Vercel Postgres / Neon in prod; local Postgres for dev)
DATABASE_URL="postgresql://crump:crump@localhost:5432/crump_studio?schema=public"

# Providers (Phase 2+). Until real keys are wired, keep mock.
VIDEO_PROVIDER="mock"
AUDIO_PROVIDER="mock"

# Optional — required only when AUDIO_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=""

# Auth (Phase 2 decision: Clerk vs NextAuth email allowlist)
# AUTH_PROVIDER="clerk"
# CLERK_SECRET_KEY=""
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# File/asset storage (Phase 2 decision: Vercel Blob vs S3)
# STORAGE_PROVIDER="blob"
# BLOB_READ_WRITE_TOKEN=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# S3_BUCKET=""

# App
NODE_ENV="development"
